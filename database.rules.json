{
  "rules": {
    "$other": { ".read": false, ".write": false },
    "meta": {
      "migrationDone": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "$obraId": {
        ".read": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val() || root.child('codes').hasChild(root.child('obras/' + $obraId + '/code').val())",
        ".write": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val()"
      }
    },
    "codes": {
      "$code": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + data.child('obraId').val() + '/companyId').val())"
      }
    },
    "companies": {
      "$cid": {
        ".read": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === $cid",
        ".write": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === $cid && root.child('users/' + auth.uid + '/role').val() === 'owner'"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users/' + auth.uid + '/companyId').val() === data.child('companyId').val())",
        ".write": "auth != null && (auth.uid === $uid || (root.child('users/' + auth.uid + '/companyId').val() === data.child('companyId').val() && root.child('users/' + auth.uid + '/role').val() === 'owner'))"
      }
    },
    "obras": {
      ".indexOn": ["companyId", "code"],
      "$obraId": {
        ".read": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === data.child('companyId').val() || root.child('codes').hasChild(data.child('code').val())",
        ".write": "auth != null && (!data.exists() || root.child('users/' + auth.uid + '/companyId').val() === data.child('companyId').val()) && (!newData.exists() || root.child('users/' + auth.uid + '/companyId').val() === newData.child('companyId').val())",
        "private": {
          ".read": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === data.parent().child('companyId').val()",
          ".write": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === data.parent().child('companyId').val()"
        }
      }
    },
    "tasks": {
      "$obraId": {
        ".read": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val() || root.child('codes').hasChild(root.child('obras/' + $obraId + '/code').val())",
        ".write": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val()"
      }
    },
    "progress": {
      "$obraId": {
        ".read": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val() || root.child('codes').hasChild(root.child('obras/' + $obraId + '/code').val())",
        ".write": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val()"
      }
    },
    "services": {
      "$obraId": {
        ".read": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val() || root.child('codes').hasChild(root.child('obras/' + $obraId + '/code').val())",
        ".write": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val()"
      }
    },
    "services-private": {
      "$obraId": {
        ".read": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val()",
        ".write": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val()"
      }
    },
    "financials": {
      "$obraId": {
        ".read": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val()",
        ".write": "auth != null && root.child('users/' + auth.uid + '/companyId').val() === root.child('obras/' + $obraId + '/companyId').val()"
      }
    }
  }
}
